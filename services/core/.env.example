DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiscal_core
CORE_HTTP_PORT=3001
CORE_GRPC_PORT=50051
DGII_ENV=TesteCF
S3_BUCKET=fiscal-xml-storage
RUST_LOG=fiscal_core=debug

# --- Secretos requeridos - el servidor NO arranca sin estos, sin fallback ---
# Genera cada uno con: openssl rand -base64 32
JWT_SECRET=
# Clave que solo tú (el vendedor) conoces, para activar licencias manualmente
# via POST /v1/tenants/:rnc/activar-licencia (header X-Vendor-Secret)
VENDOR_ADMIN_SECRET=
# Firma HMAC del estado de licencia/trial (ver license_service.rs)
LICENSE_SECRET=
# Cifra los certificados P12 DGII guardados en reposo - debe decodificar a
# exactamente 32 bytes en base64
CERT_ENCRYPTION_KEY=

# --- Frontend + email (password reset) ---
# Usado para armar el enlace de restablecer contraseña y para restringir CORS
FRONTEND_URL=http://localhost:4000
# Opcional: sin esto, el envío de correos de reset se salta con un aviso en
# los logs (útil en desarrollo) - ver https://resend.com, plan gratis 3000/mes
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Asistente IA (resumen del día + chat) ---
# Requiere Ollama corriendo (ver docker-compose.yml). Por defecto usa un
# modelo liviano (1b) para no exigir mucha RAM/CPU en hardware modesto de
# colmado; sube a 3b u otro modelo si el hardware lo permite y quieres
# respuestas de mejor calidad a cambio de más consumo.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
